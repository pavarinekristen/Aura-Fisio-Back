{
  "compilerOptions": {
    "target": "ES2023", "module": "CommonJS", "moduleResolution": "Node",
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "esModuleInterop": true, "strict": true, "skipLibCheck": true,
    "outDir": "dist", "sourceMap": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
